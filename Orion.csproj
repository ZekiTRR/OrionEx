<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Orion\Sharp\orion-app.ico</ApplicationIcon>
    <AssemblyName>Orion</AssemblyName>
    <RootNamespace>OrbitAvalonia</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
    <PackageReference Include="Avalonia.Svg.Skia" Version="11.3.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="Orion.PluginSdk\Orion.PluginSdk.csproj" />
    <Reference Include="Bunifu_UI_v1.5.3">
      <HintPath>Assets\Legacy\Krnl\Bunifu_UI_v1.5.3.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="Controls\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Include="*.axaml" />
    <AvaloniaResource Include="Assets\orbit-logo-hq.png" />
    <AvaloniaResource Include="syn_logo.png" />
    <AvaloniaResource Include="Assets\fluent--plug-connected-20-filled.svg" />
    <AvaloniaResource Include="Assets\Xeno\**\*" />
    <AvaloniaResource Include="Assets\Synapse\**\*" />
    <AvaloniaResource Include="Assets\SynapseX\**\*" />
    <AvaloniaResource Include="Assets\Calamari\**\*" />
    <AvaloniaResource Include="Assets\Orion\Sharp\**\*" />
    <AvaloniaResource Include="Assets\Orion\Nav\**\*" />
    <AvaloniaResource Include="Assets\Orion\Fonts\**\*" />
    <AvaloniaResource Include="Assets\Orion\UiSelection\**\*" />
    <AvaloniaResource Include="Assets\Bunni\**\*" />
    <AvaloniaResource Include="Assets\Velocity\**\*" />
    <AvaloniaResource Include="Assets\ScriptWare\**\*" />
    <AvaloniaResource Include="Assets\Orion\Sentinel\**\*" />
    <AvaloniaResource Include="Assets\Orion\Bridge\**\*" />
    <AvaloniaResource Include="Assets\AWP\**\*" />
    <AvaloniaResource Include="Assets\Zenith\**\*" />
    <AvaloniaResource Include="Assets\Wave\**\*" />
    <AvaloniaResource Include="Assets\WaveOld\**\*" />
    <AvaloniaResource Include="Assets\SirHurt\**\*" />
    <AvaloniaResource Include="Assets\SirHurtLegacy\**\*" />
    <AvaloniaResource Include="Assets\rect200.png" />
    <AvaloniaResource Include="Assets\rect204.png" />
    <AvaloniaResource Include="Assets\rect205.png" />
    <AvaloniaResource Include="Assets\rect206.png" />
    <AvaloniaResource Include="Assets\rect208.png" />
    <AvaloniaResource Include="Assets\rect211.png" />
    <AvaloniaResource Include="Assets\rect212.png" />
    <AvaloniaResource Include="Assets\rect213.png" />
    <EmbeddedResource Include="Assets\Legacy\RC7\*.bmp"
                      Link="RC7Assets\%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Legacy\RC7\rc7_nKh_icon.ico"
                      Link="RC7Assets\rc7_nKh_icon.ico" />
    <EmbeddedResource Include="Assets\Legacy\RC7\Light\*.bmp"
                      Link="RC7Assets\Light\%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Legacy\Krnl\krnl.resx"
                      Link="KrnlAssets\krnl.resx"
                      LogicalName="OrbitAvalonia.KrnlSource.xml"
                      Type="Non-Resx"
                      WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="MonacoPreview\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
    <Content Include="MonacoPreviewLegacy\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
    <Content Include="Scripts\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
    <Content Include="SirHurtV5UI\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
    <Content Include="luau-lsp.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
    <Content Include="luau\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <SynapseV3AltSource Include="SynapseV3AltUI\src\**\*;SynapseV3AltUI\console\**\*;SynapseV3AltUI\assets\**\*;SynapseV3AltUI\themes\**\*;SynapseV3AltUI\*.json;SynapseV3AltUI\*.mjs;SynapseV3AltUI\*.js;SynapseV3AltUI\*.html;MonacoPreview\**\*" />
  </ItemGroup>

  <Target Name="InstallSynapseV3AltDependencies" Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="SynapseV3AltUI\package.json;SynapseV3AltUI\package-lock.json"
          Outputs="SynapseV3AltUI\node_modules\.package-lock.json">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\SynapseV3AltUI" Command="npm ci --no-audit --no-fund" />
  </Target>

  <Target Name="BuildSynapseV3Alt" DependsOnTargets="InstallSynapseV3AltDependencies"
          Condition="'$(DesignTimeBuild)' != 'true'" Inputs="@(SynapseV3AltSource)"
          Outputs="SynapseV3AltUI\dist\.build-stamp">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\SynapseV3AltUI" Command="npm run build" />
    <Touch Files="SynapseV3AltUI\dist\.build-stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="IncludeSynapseV3Alt" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildSynapseV3Alt"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('SynapseV3AltUI\dist\index.html')" Text="SynapseV3Alt frontend build did not produce dist/index.html." />
    <ItemGroup>
      <Content Include="SynapseV3AltUI\dist\**\*" Exclude="SynapseV3AltUI\dist\.build-stamp"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveOrionPublishSymbols" AfterTargets="Publish">
    <ItemGroup>
      <OrionPublishSymbol Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(OrionPublishSymbol)" />
  </Target>

  <Target Name="PublishOrionPluginSdk" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)Plugin SDK" />
    <Copy SourceFiles="$(TargetDir)Orion.PluginSdk.dll"
          DestinationFolder="$(PublishDir)Plugin SDK" />
    <Copy SourceFiles="$(TargetDir)Orion.PluginSdk.xml"
          DestinationFolder="$(PublishDir)Plugin SDK"
          Condition="Exists('$(TargetDir)Orion.PluginSdk.xml')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Orion.PluginSdk\README.md"
          DestinationFolder="$(PublishDir)Plugin SDK" />
  </Target>

</Project>
