<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OrbitAvalonia.SentinelScriptHubWindow"
        Title="Sentinel — Script Hub"
        Width="388" Height="337"
        MinWidth="388" MinHeight="337"
        MaxWidth="388" MaxHeight="337"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        FontFamily="avares://Orion/Assets/Zenith/Fonts#Nunito"
        FontSize="12"
        RenderOptions.TextRenderingMode="Antialias"
        Icon="avares://Orion/Assets/Orion/Sentinel/sentinel.ico">

  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.sn-close">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Foreground" Value="#E8E8E8" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.sn-close:pointerover">
      <Setter Property="Foreground" Value="#DB1739" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Reference .script-list button: height 18, left aligned -->
    <Style Selector="Button.sn-hub">
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#F4F4F4" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.sn-hub:pointerover">
      <Setter Property="Foreground" Value="#DB1739" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.sn-hub-exec">
      <Setter Property="Height" Value="16" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#F4F4F4" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.sn-hub-exec:pointerover">
      <Setter Property="Foreground" Value="#DB1739" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TextBox.sn-preview">
      <Setter Property="Background" Value="#202020" />
      <Setter Property="Foreground" Value="#CCCCCC" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="CaretBrush" Value="#CCCCCC" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
  </Window.Styles>

  <!-- Reference ".hub-window" card: 386x335, #202020, 1px #101010, radius 7 -->
  <Border CornerRadius="7" Background="#202020" BorderBrush="#101010" BorderThickness="1"
          BoxShadow="0 4 8 0 #8C000000" ClipToBounds="True">
    <Grid RowDefinitions="33,*">
      <Border Grid.Row="0" Background="Transparent" BorderBrush="#111111" BorderThickness="0,0,0,1"
              PointerPressed="TitleBar_PointerPressed">
        <Button Classes="sn-close" Click="Close_Click" HorizontalAlignment="Right"
                VerticalAlignment="Top" Margin="0,8,8,0">
          <TextBlock Text="✕" FontSize="12" />
        </Button>
      </Border>

      <!-- Reference .hub-content: 6px padding, 6px gap -->
      <Grid Grid.Row="1" Margin="6,6,6,7" ColumnDefinitions="97,6,*">
        <Border Grid.Column="0" Background="#181818" Padding="5,7">
          <StackPanel>
            <Button Classes="sn-hub" Content="Dark Dex" Click="HubItem_Click" Tag="DexRER" />
            <Button Classes="sn-hub" Content="Remote Spy" Click="HubItem_Click" Tag="Cobalt Spy" />
            <Button Classes="sn-hub" Content="InfYield" Click="HubItem_Click" Tag="infyield" />
          </StackPanel>
        </Border>
        <Grid Grid.Column="2" RowDefinitions="*,5,70,5,16">
          <TextBox Grid.Row="0" x:Name="PreviewBox" Classes="sn-preview" Text="" />
          <Border Grid.Row="2" Background="#202020" CornerRadius="3" Padding="8,6">
            <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="#B7B7B7"
                       TextWrapping="Wrap" VerticalAlignment="Top" />
          </Border>
          <Button Grid.Row="4" Classes="sn-hub-exec" Content="Execute" Click="Execute_Click" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
