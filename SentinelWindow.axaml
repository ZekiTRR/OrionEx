<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OrbitAvalonia.SentinelWindow"
        Title="Sentinel"
        Width="1100" Height="320"
        MinWidth="700" MinHeight="220"
        Background="#0D0D0D"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Arial"
        RenderOptions.TextRenderingMode="Antialias"
        Icon="avares://Orion/Assets/Orion/Sharp/orion-app.ico">

  <Window.Resources>
    <StreamGeometry x:Key="SnPlayIcon">M8 5.5v13L19 12Z</StreamGeometry>
    <StreamGeometry x:Key="AwOpenIcon">M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M14 2v4a2 2 0 0 0 2 2h4</StreamGeometry>
    <StreamGeometry x:Key="AwSaveIcon">M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z M17 21v-8H7v8 M7 3v5h8</StreamGeometry>
    <StreamGeometry x:Key="AwTrashIcon">M3 6h18 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6</StreamGeometry>
    <StreamGeometry x:Key="AwGearIcon">M12 15.5A3.5 3.5 0 1 0 12 8.5a3.5 3.5 0 0 0 0 7Z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.01a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h.01a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.01a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z</StreamGeometry>
    <StreamGeometry x:Key="AwPaperclipIcon">M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48</StreamGeometry>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Title bar buttons -->
    <Style Selector="Button.sn-sys">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#999999" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.sn-sys:pointerover">
      <Setter Property="Background" Value="#2A2A2A" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Tab items -->
    <Style Selector="Button.sn-tab">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="#1A1A1A" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4,4,0,0" />
      <Setter Property="Foreground" Value="#999999" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.1" />
          <BrushTransition Property="Foreground" Duration="0:0:0.1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.sn-tab.active">
      <Setter Property="Background" Value="#0D0D0D" />
      <Setter Property="Foreground" Value="#E8E8E8" />
    </Style>
    <Style Selector="Button.sn-tab:pointerover">
      <Setter Property="Foreground" Value="#CCCCCC" />
    </Style>

    <!-- Bottom bar buttons -->
    <Style Selector="Button.sn-act">
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#AAAAAA" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.sn-act:pointerover">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.sn-act Path">
      <Setter Property="Stroke" Value="#AAAAAA" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Button.sn-act:pointerover Path">
      <Setter Property="Stroke" Value="White" />
    </Style>

    <!-- Settings sidebar toggle -->
    <Style Selector="ToggleButton.sn-toggle">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#CCCCCC" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="ToggleButton.sn-toggle:pointerover">
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- File list -->
    <Style Selector="ListBox.sn-files">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#CCCCCC" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.sn-files ListBoxItem">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.sn-files ListBoxItem:pointerover">
      <Setter Property="Background" Value="#1A1A1A" />
    </Style>
    <Style Selector="ListBox.sn-files ListBoxItem:selected">
      <Setter Property="Background" Value="#222222" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="28,*">

    <!-- ═══ Title bar ═══ -->
    <Grid Grid.Row="0" Background="#0D0D0D" PointerPressed="TitleBar_PointerPressed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
        <TextBlock Text="S" FontSize="14" FontWeight="Bold" Foreground="#E84C6C" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
        <Button Classes="sn-sys" Click="Minimize_Click" ToolTip.Tip="Minimize">
          <TextBlock Text="—" />
        </Button>
        <Button Classes="sn-sys" Click="Close_Click" ToolTip.Tip="Return to Orion">
          <TextBlock Text="✕" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- ═══ Body: Main + Scripts ═══ -->
    <Grid Grid.Row="1" ColumnDefinitions="*,200">

      <!-- ─── Main panel (left) ─── -->
      <Grid Grid.Column="0" RowDefinitions="26,*" Margin="0,0,1,0" Background="#0D0D0D">

        <!-- Tab bar -->
        <Border Grid.Row="0" Background="#111111" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="TabStrip" Orientation="Horizontal" Margin="4,1,0,0" Spacing="2" VerticalAlignment="Center" />
          </ScrollViewer>
        </Border>

        <!-- Monaco editor -->
        <Border Grid.Row="1" Background="#0D0D0D">
          <NativeWebView x:Name="EditorWebView" Background="#0D0D0D" IsVisible="False" />
        </Border>

        <!-- Bottom action bar -->
        <Border Grid.Row="2" Grid.RowSpan="2" Background="#111111" BorderBrush="#1A1A1A"
                BorderThickness="0,1,0,0" VerticalAlignment="Bottom" ZIndex="10">
          <Grid Margin="8,0" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
              <Button Classes="sn-act" Click="Execute_Click" ToolTip.Tip="Execute (F5)">Execute</Button>
              <Button Classes="sn-act" Click="Open_Click" ToolTip.Tip="Open (Ctrl+O)">Open</Button>
              <Button Classes="sn-act" Click="Save_Click" ToolTip.Tip="Save (Ctrl+S)">Save</Button>
              <Button Classes="sn-act" Click="Clear_Click" ToolTip.Tip="Clear">Clear</Button>
              <Button Classes="sn-act" Click="Attach_Click" ToolTip.Tip="Attach">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Path Data="{StaticResource AwPaperclipIcon}" Width="12" Height="12" Stretch="Uniform" />
                  <TextBlock Text="Attach" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
              <Button Classes="sn-act" Click="ScriptHub_Click" ToolTip.Tip="Script Hub">Script Hub</Button>
              <Button Classes="sn-act" Click="Settings_Click" ToolTip.Tip="Settings">
                <Path Data="{StaticResource AwGearIcon}" Width="12" Height="12" Stretch="Uniform" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- ─── Scripts panel (right) ─── -->
      <Border Grid.Column="1" Background="#0D0D0D" BorderBrush="#1A1A1A" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="26,*">
          <Border Grid.Row="0" Background="#111111" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
            <TextBlock Text="BSS.txt" FontSize="11" Foreground="#999999" VerticalAlignment="Center"
                       Margin="8,0,0,0" />
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ListBox x:Name="ScriptsList" Classes="sn-files" DoubleTapped="ScriptsList_DoubleTapped" />
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- ═══ Settings sidebar popup ═══ -->
      <Panel x:Name="SettingsOverlay" Grid.Row="0" Grid.RowSpan="2" IsVisible="False" ZIndex="100">
        <Border Background="#66000000" PointerPressed="SettingsBackdrop_Click" />
        <Border Width="130" Background="#111111" BorderBrush="#222222" BorderThickness="1"
                CornerRadius="0,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="0,28,0,0" ClipToBounds="True">
          <StackPanel Margin="0,4" Spacing="0">
            <ToggleButton Classes="sn-toggle" x:Name="TglUnlockFps" Content="     Unlock FPS" />
            <ToggleButton Classes="sn-toggle" x:Name="TglAutoLaunch" Content="     Auto Launch" />
            <ToggleButton Classes="sn-toggle" x:Name="TglAutoAttach" Content="     Auto Attach" />
            <ToggleButton Classes="sn-toggle" x:Name="TglInternalUi" Content="     Internal UI" />
            <ToggleButton Classes="sn-toggle" x:Name="TglLegacyUi" Content="     Legacy UI" />
            <ToggleButton Classes="sn-toggle" x:Name="TglTopMost" Content="     Top Most"
                          IsCheckedChanged="TglTopMost_Changed" />
            <Button Classes="sn-toggle" Content="     Kill Roblox" Click="KillRoblox_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
          </StackPanel>
        </Border>
      </Panel>
    </Grid>
  </Grid>
</Window>
