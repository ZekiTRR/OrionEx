<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OrbitAvalonia.SentinelWindow"
        Title="Sentinel"
        Width="586" Height="306"
        MinWidth="500" MinHeight="280"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        FontFamily="avares://Orion/Assets/Zenith/Fonts#Nunito"
        FontSize="12"
        RenderOptions.TextRenderingMode="Antialias"
        Icon="avares://Orion/Assets/Orion/Sentinel/sentinel.ico">

  <Window.Resources>
    <StreamGeometry x:Key="AwPaperclipIcon">M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48</StreamGeometry>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button.sn-close">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Foreground" Value="#E8E8E8" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.sn-close:pointerover">
      <Setter Property="Foreground" Value="#DB1739" />
      <Setter Property="Background" Value="#2A0000" />
    </Style>

    <Style Selector="Button.sn-footer">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#F4F4F4" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Button.sn-footer:pointerover">
      <Setter Property="Foreground" Value="#DB1739" />
      <Setter Property="Background" Value="#2A0000" />
    </Style>
    <Style Selector="Button.sn-footer Path">
      <Setter Property="Stroke" Value="#F4F4F4" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Button.sn-footer:pointerover Path">
      <Setter Property="Stroke" Value="#DB1739" />
    </Style>
  </Window.Styles>

  <!-- The window itself is the reference ".window" card:
       #202020 behind, 1px #101010 border, 7px radius, drop shadow. -->
  <Border CornerRadius="7" Background="#202020" BorderBrush="#101010" BorderThickness="1"
          BoxShadow="0 4 8 0 #8C000000" ClipToBounds="True">
    <Grid RowDefinitions="33,*,26">

      <!-- ═══ Title bar (33px, #181818) ═══ -->
      <Border Grid.Row="0" Background="#181818" BorderBrush="#101010" BorderThickness="0,0,0,1"
              PointerPressed="TitleBar_PointerPressed">
        <Grid Margin="8,0" ColumnDefinitions="Auto,*,Auto">
          <Image Source="avares://Orion/Assets/Orion/Sentinel/sentinel.png"
                 Width="17" Height="20" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
            <Button Classes="sn-close" Click="EditorMinimize_Click">
              <Rectangle Width="10" Height="1" Fill="#DDDDDD" VerticalAlignment="Center" />
            </Button>
            <Button Classes="sn-close" Click="EditorClose_Click">
              <TextBlock Text="✕" FontSize="12" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ═══ Editor layout (reference .editor-layout: 6px padding, 7px gap) ═══ -->
      <Grid Grid.Row="1" Margin="6,6,6,0" ColumnDefinitions="*,7,139">

        <!-- .editor-main: tabbar (23px) over the code surface -->
        <Grid Grid.Column="0" RowDefinitions="23,*" Background="#181818">
          <Border Grid.Row="0" Background="#181818">
            <ScrollViewer x:Name="TabScroll" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          PointerWheelChanged="TabScroll_PointerWheelChanged">
              <StackPanel x:Name="TabStrip" Orientation="Horizontal" VerticalAlignment="Stretch" />
            </ScrollViewer>
          </Border>
          <Grid Grid.Row="1">
            <NativeWebView x:Name="EditorWebView" Background="#181818" IsVisible="False" />
            <Border x:Name="ConsolePanel" Background="#181818" IsVisible="False">
              <ScrollViewer x:Name="ConsoleScroll" Background="Transparent" Padding="8,6">
                <StackPanel x:Name="ConsoleOutput" Orientation="Vertical" />
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>

        <!-- .file-pane (139px, full height) -->
        <Border Grid.Column="2" Background="#181818">
          <Grid RowDefinitions="24,*">
            <TextBlock Grid.Row="0" Text="Script List" FontSize="12" Foreground="#B7B7B7"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ListBox Grid.Row="1" x:Name="ScriptsList" Classes="sn-files" Background="Transparent"
                     BorderThickness="0" FontSize="12" Foreground="#CCCCCC"
                     DoubleTapped="ScriptsList_DoubleTapped" Margin="4,0" />
          </Grid>
        </Border>
      </Grid>

      <!-- ═══ Footer (26px) ═══ -->
      <Border Grid.Row="2" Background="Transparent" BorderBrush="#101010" BorderThickness="0,1,0,0">
        <Grid Margin="12,0,10,1" ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="15">
            <Button Classes="sn-footer" Click="Execute_Click" ToolTip.Tip="Execute (F5)">Execute</Button>
            <Button Classes="sn-footer" Click="Open_Click" ToolTip.Tip="Open (Ctrl+O)">Open</Button>
            <Button Classes="sn-footer" Click="Save_Click" ToolTip.Tip="Save (Ctrl+S)">Save</Button>
            <Button Classes="sn-footer" Click="Clear_Click" ToolTip.Tip="Clear">Clear</Button>
            <Button Classes="sn-footer" Click="Attach_Click" ToolTip.Tip="Attach">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Path Data="{StaticResource AwPaperclipIcon}" Width="11" Height="11" Stretch="Uniform"
                      Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                      StrokeLineCap="Round" StrokeJoin="Round" />
                <TextBlock Text="Attach" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="17">
            <Button Classes="sn-footer" Click="ScriptHub_Click">Script Hub</Button>
            <Button Classes="sn-footer" Click="Settings_Click">Settings</Button>
          </StackPanel>
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>
