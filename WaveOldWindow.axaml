  </Window.Resources>

  <Window.Styles>
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://Orion/Assets/WaveOld#Izmir" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="avares://Orion/Assets/WaveOld#Izmir" />
    </Style>
    <Style Selector="ToggleButton">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <!-- Window control buttons -->
    <Style Selector="Button.WaveOld-win">
      <Setter Property="Width" Value="50" />
      <Setter Property="Height" Value="50" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.WaveOld-win Path">
      <Setter Property="Fill" Value="#B2B2B2" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Fill" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.WaveOld-win:pointerover">
      <Setter Property="Background" Value="#1F1F22" />
    </Style>
    <Style Selector="Button.WaveOld-win:pointerover Path">
      <Setter Property="Fill" Value="#FFFFFF" />
    </Style>

    <!-- Rail toggle buttons (left side icon column) -->
    <Style Selector="ToggleButton.WaveOld-rail">
      <Setter Property="Width" Value="55" />
      <Setter Property="Height" Value="54" />
      <Setter Property="Padding" Value="15" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#B2B2B2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.WaveOld-rail Path">
      <Setter Property="Fill" Value="{Binding $parent[ToggleButton].Foreground}" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.WaveOld-rail Image">
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.WaveOld-rail:pointerover">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ToggleButton.WaveOld-rail:pointerover Path">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.WaveOld-rail:pointerover Image">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.WaveOld-rail:checked">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ToggleButton.WaveOld-rail:checked Path">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.WaveOld-rail:checked Image">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Editor toolbar (bottom right) icon buttons -->
    <Style Selector="Button.WaveOld-tool">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="11" />
      <Setter Property="Foreground" Value="#B2B2B2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.WaveOld-tool Path">
      <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.WaveOld-tool Image">
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.WaveOld-tool:pointerover">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.WaveOld-tool:pointerover Path">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.WaveOld-tool:pointerover Image">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Side panel toggle (blue strip) -->
    <Style Selector="Border.WaveOld-sidebutton">
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Background" Value="#267DE5" />
      <Setter Property="CornerRadius" Value="2.5" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="5,0,0,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Script Cloud search input -->
    <Style Selector="TextBox.WaveOld-search">
      <Setter Property="Height" Value="34" />
      <Setter Property="Background" Value="#1D1D1E" />
      <Setter Property="BorderBrush" Value="#FF2C2C2D" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Foreground" Value="#FFC8C8C8" />
      <Setter Property="CaretBrush" Value="#C8C8C8" />
      <Setter Property="FontFamily" Value="avares://Orion/Assets/WaveOld#Izmir" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="10,5,10,0" />
    </Style>
    <Style Selector="TextBox.WaveOld-search /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#1D1D1E" />
      <Setter Property="BorderBrush" Value="#FF2C2C2D" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>

    <!-- Script Cloud pagination buttons -->
    <Style Selector="Button.WaveOld-page">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Background" Value="#1D1D1E" />
      <Setter Property="BorderBrush" Value="#FF2C2C2D" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="8,8,8,8" />
      <Setter Property="Foreground" Value="#C8C8C8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.WaveOld-page Path">
      <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style Selector="Button.WaveOld-page:pointerover">
      <Setter Property="Background" Value="#27272A" />
    </Style>

    <!-- Page counter pill -->
    <Style Selector="Border.WaveOld-counter">
      <Setter Property="Height" Value="34" />
      <Setter Property="Background" Value="#1D1D1E" />
      <Setter Property="BorderBrush" Value="#FF2C2C2D" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Margin" Value="5,0" />
    </Style>

    <!-- Script card (Wave Source style) -->
    <Style Selector="Border.WaveOld-scriptcard">
      <Setter Property="Width" Value="206.333" />
      <Setter Property="Height" Value="131.5" />
      <Setter Property="Background" Value="#1D1D1E" />
      <Setter Property="BorderBrush" Value="#FF2C2C2D" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,0,25,25" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- Settings section header (icon + title) -->
    <Style Selector="TextBlock.WaveOld-section-title">
      <Setter Property="Foreground" Value="#FFC8C8C8" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontFamily" Value="Segoe UI, Inter, sans-serif" />
      <Setter Property="Margin" Value="35,3,0,0" />
    </Style>
    <Style Selector="Path.WaveOld-section-icon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Fill" Value="#FFB2B2B2" />
      <Setter Property="Stretch" Value="Fill" />
    </Style>

    <!-- Settings settings card (CheckBox / Slider) -->
    <Style Selector="Border.WaveOld-setting">
      <Setter Property="Background" Value="#1D1D1E" />
      <Setter Property="BorderBrush" Value="#FF2C2C2D" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="15,10" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.WaveOld-settinghit">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Background" Value="#0F0F10" />
      <Setter Property="BorderBrush" Value="#FF2C2C2D" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.WaveOld-settingtitle">
      <Setter Property="Foreground" Value="#FFDCDCDC" />
      <Setter Property="FontFamily" Value="Segoe UI, Inter, sans-serif" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="TextBlock.WaveOld-settingdesc">
      <Setter Property="Foreground" Value="#FFB2B2B2" />
      <Setter Property="FontFamily" Value="Segoe UI, Inter, sans-serif" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.WaveOld-check">
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Script Hub provider selector buttons -->
    <Style Selector="Button.WaveOld-provider">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="#1D1D1E" />
      <Setter Property="BorderBrush" Value="#2C2C2D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="#8CA0BA" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontFamily" Value="avares://Orion/Assets/WaveOld#Izmir" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" />
          <BrushTransition Property="Foreground" Duration="0:0:0.14" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.WaveOld-provider.active">
      <Setter Property="Background" Value="#267DE5" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#267DE5" />
    </Style>
    <Style Selector="Button.WaveOld-provider:pointerover">
      <Setter Property="Background" Value="#2A3F66" />
    </Style>
    <Style Selector="Button.WaveOld-provider.active:pointerover">
      <Setter Property="Background" Value="#3686F0" />
    </Style>
  </Window.Styles>

  <Border x:Name="WaveOldChrome"
          Background="#FF0F0F10"
          BorderBrush="#FF1D1D1E"
          BorderThickness="1"
          CornerRadius="8"
          Margin="4,0,4,0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="55" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- ══════════ Left rail (icons + selection bar) ══════════ -->
      <Grid Grid.Row="0" Grid.RowSpan="2" Width="55" HorizontalAlignment="Left">
        <Image Source="avares://Orion/Assets/WaveOld/wave-28x28.png"
               Width="28" Height="28"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Margin="0,15,0,0"
               RenderOptions.BitmapInterpolationMode="HighQuality" />

        <StackPanel Margin="0,51,0,0" HorizontalAlignment="Stretch">
          <ToggleButton x:Name="EditorToggleButton" Classes="WaveOld-rail" IsChecked="True" Click="EditorToggleButton_Click">
            <Path Data="{StaticResource WaveOldIconEditor}" />
          </ToggleButton>
          <ToggleButton x:Name="ScriptCloudToggleButton" Classes="WaveOld-rail" Click="ScriptCloudToggleButton_Click" Padding="15">
            <Path Data="{StaticResource WaveOldIconCloud}" Stretch="Uniform" />
          </ToggleButton>
          <ToggleButton x:Name="SettingsToggleButton" Classes="WaveOld-rail" Click="SettingsToggleButton_Click">
            <Path Data="{StaticResource WaveOldIconSettings}" />
          </ToggleButton>
        </StackPanel>
      </Grid>

      <!-- ══════════ Title bar ══════════ -->
      <Grid Grid.Row="0" Margin="55,0,0,0" Background="Transparent" PointerPressed="TitleBar_PointerPressed">
        <Image Source="avares://Orion/Assets/WaveOld/wave-text.png"
               Height="14"
               HorizontalAlignment="Left"
               VerticalAlignment="Bottom"
               Margin="15,0,0,16"
               RenderOptions.BitmapInterpolationMode="HighQuality" />

        <!-- Window control buttons -->
        <Button Classes="WaveOld-win" Click="ExitButton_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                ToolTip.Tip="Close">
          <Path Data="{StaticResource WaveOldIconClose}" Stretch="Uniform" Width="14" Height="14" />
        </Button>
        <Button Classes="WaveOld-win" Click="MaximizeButton_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,0,50,0" BorderThickness="0"
                ToolTip.Tip="Maximize">
          <Path Data="{StaticResource WaveOldIconMaximize}" Stretch="Uniform" Width="14" Height="14" />
        </Button>
        <Button Classes="WaveOld-win" Click="MinimizeButton_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,0,100,0" BorderThickness="0"
                ToolTip.Tip="Minimize">
          <Path Data="{StaticResource WaveOldIconMinimize}" Stretch="Uniform" Width="14" Height="2" />
        </Button>
      </Grid>

      <!-- ══════════ Main content area ══════════ -->
      <Grid Grid.Row="1" Margin="55,0,0,0">
        <Border BorderBrush="#FF1D1D1E" BorderThickness="1,1,0,0" CornerRadius="6,0,0,0">
          <Grid ClipToBounds="True">

            <!-- ── Editor page ── -->
            <Grid x:Name="EditorPage" IsVisible="True">
              <Grid>
                <!-- Explorer sidebar (collapsed by default, replaces AI panel) -->
                <Border x:Name="SidePanel" Width="0" HorizontalAlignment="Left" ClipToBounds="True">
                  <Border Background="#101B30" BorderBrush="#1E2E4C" BorderThickness="0,0,1,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                      <StackPanel x:Name="ExplorerTree" Margin="10,10,10,10" Spacing="4" />
                    </ScrollViewer>
                  </Border>
                </Border>

                <!-- Editor panel (always visible) -->
                <Border x:Name="EditorPanel" Background="#FF0F0F10" CornerRadius="5,0,0,0" ClipToBounds="True">
                  <Grid>
                    <!-- Background.png covers the whole editor area behind everything -->
                    <Image Source="avares://Orion/Assets/WaveOld/background.png"
                           Stretch="UniformToFill"
                           Opacity="0.35"
                           IsHitTestVisible="False"
                           Grid.RowSpan="3" />

                    <Grid.RowDefinitions>
                      <RowDefinition Height="36" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="40" />
                    </Grid.RowDefinitions>

                    <!-- Tab strip -->
                    <Border Grid.Row="0" Background="#FF0F0F10" BorderBrush="#FF1D1D1E" BorderThickness="0,0,0,1">
                      <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TabStrip" Orientation="Horizontal" Margin="6,4,0,0" Spacing="4" VerticalAlignment="Center" />
                      </ScrollViewer>
                    </Border>

                    <!-- Monaco editor -->
                    <Border Grid.Row="1" Margin="0">
                      <NativeWebView x:Name="EditorWebView" Background="Transparent" IsVisible="False" />
                    </Border>

                    <!-- Editor bottom toolbar -->
                    <Border Grid.Row="2" Background="#FF0F0F10" BorderBrush="#FF1D1D1E" BorderThickness="0,1,0,0">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Button Classes="WaveOld-tool" x:Name="OpenFileButton" Click="OpenFileButton_Click" ToolTip.Tip="Open file" Padding="11">
                          <Path Data="{StaticResource WaveOldIconOpen}" Stretch="Uniform" />
                        </Button>
                        <Button Classes="WaveOld-tool" x:Name="SaveFileButton" Click="SaveFileButton_Click" ToolTip.Tip="Save file" Padding="11">
                          <Path Data="{StaticResource WaveOldIconSave}" Stretch="Uniform" />
                        </Button>
                        <Button Classes="WaveOld-tool" x:Name="ClearButton" Click="ClearButton_Click" ToolTip.Tip="Clear" Padding="11">
                          <Path Data="{StaticResource WaveOldIconClear}" Stretch="Uniform" Margin="0,2,0,0" />
                        </Button>
                        <Button Classes="WaveOld-tool" x:Name="ExecuteButton" Click="ExecuteButton_Click" ToolTip.Tip="Execute (Ctrl+Enter)" Padding="11">
                          <Path Data="{StaticResource WaveOldIconExecute}" Stretch="Uniform" />
                        </Button>
                      </StackPanel>
                    </Border>

                    <!-- Side panel toggle (blue strip) -->
                    <Border x:Name="SidePanelButton" Classes="WaveOld-sidebutton" PointerPressed="SidePanelButton_PointerPressed" />
                  </Grid>
                </Border>
              </Grid>
            </Grid>

            <!-- ── ScriptCloud page ── -->
            <Grid x:Name="ScriptCloudPage" IsVisible="False">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <!-- Search bar -->
              <Grid Grid.Row="0" Margin="14,12,14,6">
                <TextBox x:Name="HubSearch" Classes="WaveOld-search"
                         Watermark="Search scripts..." TextChanged="HubSearch_TextChanged" />
              </Grid>

              <!-- Provider selector -->
              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,0,14,8" Spacing="6">
                <Button x:Name="HubProviderScriptBlox" Classes="WaveOld-provider active" Click="HubProvider_Click" Tag="ScriptBlox">
                  <TextBlock Text="ScriptBlox" />
                </Button>
                <Button x:Name="HubProviderRscripts" Classes="WaveOld-provider" Click="HubProvider_Click" Tag="Rscripts">
                  <TextBlock Text="Rscripts" />
                </Button>
                <Button x:Name="HubProviderRobloxScripts" Classes="WaveOld-provider" Click="HubProvider_Click" Tag="RobloxScripts">
                  <TextBlock Text="Roblox" />
                </Button>
                <Button x:Name="HubProviderHaxHell" Classes="WaveOld-provider" Click="HubProvider_Click" Tag="HaxHell">
                  <TextBlock Text="HaxHell" />
                </Button>
                <Button x:Name="HubRefresh" Classes="WaveOld-page" Click="HubRefresh_Click"
                        ToolTip.Tip="Refresh" Margin="6,0,0,0">
                  <Path Data="{StaticResource WaveOldIconRefresh}" Width="16" Height="16" Stretch="Uniform" />
                </Button>
              </StackPanel>

              <!-- List of script cards -->
              <ListBox Grid.Row="2" x:Name="HubList" Classes="WaveOld-list"
                       Background="Transparent" DoubleTapped="HubList_DoubleTapped"
                       Margin="14,0,6,0">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,10,10" />
                    <Setter Property="Background" Value="Transparent" />
                  </Style>
                </ListBox.Styles>
              </ListBox>

              <!-- Empty state / loading -->
              <TextBlock Grid.Row="2" x:Name="HubEmpty" Text="Loading…"
                         Foreground="#5A5A5A" FontSize="12" FontStyle="Italic"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="True" />
            </Grid>

            <!-- ── Settings page ── -->
            <Grid x:Name="SettingsPage" IsVisible="False">
              <Border Height="50" BorderBrush="#FF1D1D1E" BorderThickness="0,0,0,1" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="SettingsExecutorToggleButton" Click="SettingsExecutorToggleButton_Click"
                          Height="50" Width="50" Background="Transparent" BorderThickness="0" Padding="13" Foreground="#C8C8C8" Cursor="Hand">
                    <Path Data="{StaticResource WaveOldIconExecutor}" Fill="{Binding $parent[Button].Foreground}" Stretch="Uniform" />
                  </Button>
                  <Button x:Name="SettingsEditorToggleButton" Click="SettingsEditorToggleButton_Click"
                          Height="50" Width="50" Background="Transparent" BorderThickness="0" Padding="13" Foreground="#C8C8C8" Cursor="Hand">
                    <Path Data="{StaticResource WaveOldIconEditorSection}" Fill="{Binding $parent[Button].Foreground}" Stretch="Uniform" />
                  </Button>
                  <Button x:Name="SettingsAiToggleButton" Click="SettingsAiToggleButton_Click"
                          Height="50" Width="50" Background="Transparent" BorderThickness="0" Padding="13" Foreground="#C8C8C8" Cursor="Hand" IsVisible="False">
                    <Path Data="{StaticResource WaveOldIconAi}" Fill="{Binding $parent[Button].Foreground}" Stretch="Uniform" />
                  </Button>
                </StackPanel>
              </Border>

              <ScrollViewer Margin="0,50,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <!-- Executor section -->
                  <Grid x:Name="SettingsExecutorSection" Margin="25,25,25,0">
                    <Path Classes="WaveOld-section-icon" Data="{StaticResource WaveOldIconExecutor}"
                          HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <TextBlock Classes="WaveOld-section-title" Text="Executor" />
                    <StackPanel Margin="0,40,0,0">
                      <Border Classes="WaveOld-setting">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Classes="WaveOld-settingtitle" Text="Top Most" />
                            <TextBlock Classes="WaveOld-settingdesc" Text="Keeps the application on top of other windows, even when it is not in focus." />
                          </StackPanel>
                          <Border Classes="WaveOld-settinghit" x:Name="TopMostHit" Grid.Column="1" PointerPressed="TopMostHit_PointerPressed">
                            <TextBlock Classes="WaveOld-check" Text="✓" />
                          </Border>
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Grid>

                  <!-- Editor section -->
                  <Grid x:Name="SettingsEditorSection" Margin="25,25,25,0">
                    <Path Classes="WaveOld-section-icon" Data="{StaticResource WaveOldIconEditorSection}"
                          HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <TextBlock Classes="WaveOld-section-title" Text="Editor" />
                    <StackPanel Margin="0,40,0,0">
                      <Border Classes="WaveOld-setting">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Classes="WaveOld-settingtitle" Text="Font Size" />
                            <TextBlock Classes="WaveOld-settingdesc" Text="Adjusts the font size of the editor." />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Slider x:Name="FontSizeSlider" Width="160" Minimum="8" Maximum="32" Value="14" TickFrequency="1" ValueChanged="FontSizeSlider_ValueChanged" />
                            <TextBlock x:Name="FontSizeValue" Text="14" Foreground="#C8C8C8" FontSize="13" Width="32" TextAlignment="Right" VerticalAlignment="Center" />
                          </StackPanel>
                        </Grid>
                      </Border>
                      <Border Classes="WaveOld-setting">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Classes="WaveOld-settingtitle" Text="Minimap" />
                            <TextBlock Classes="WaveOld-settingdesc" Text="Displays a condensed view of your entire script in a sidebar on the right of the editor." />
                          </StackPanel>
                          <Border Classes="WaveOld-settinghit" x:Name="MinimapHit" Grid.Column="1" PointerPressed="MinimapHit_PointerPressed">
                            <TextBlock Classes="WaveOld-check" Text="✓" />
                          </Border>
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Grid>

                  <!-- AI section (Collapsed by default, like Wave Source) -->
                  <Grid x:Name="SettingsAiSection" Margin="25,25,25,0" IsVisible="False">
                    <Path Classes="WaveOld-section-icon" Data="{StaticResource WaveOldIconAi}"
                          HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <TextBlock Classes="WaveOld-section-title" Text="Artificial Intelligence" />
                    <StackPanel Margin="0,40,0,0">
                      <Border Classes="WaveOld-setting">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Classes="WaveOld-settingtitle" Text="Send Current Document" />
                            <TextBlock Classes="WaveOld-settingdesc" Text="Transmits your current document along with your AI prompt to improve code generation." />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </ScrollViewer>
            </Grid>

          </Grid>
        </Border>
      </Grid>

      <!-- ══════════ Toast Container (top-level overlay) ══════════ -->
      <controls:WaveOldToastContainer x:Name="ToastContainer" Grid.Row="0" Grid.RowSpan="2" ZIndex="200" />
    </Grid>
  </Border>
</Window>
