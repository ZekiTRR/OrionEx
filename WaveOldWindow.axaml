<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OrbitAvalonia.Controls"
        x:Class="OrbitAvalonia.WaveOldWindow"
        Title="Wave"
        Width="800" Height="446"
        MinWidth="800" MinHeight="446"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="avares://Orion/Assets/WaveOld#Izmir"
        RenderOptions.TextRenderingMode="Antialias"
        Icon="avares://Orion/Assets/Orion/Sharp/orion-app.ico">

